{
  "$schema": "../../opencode/packages/opencode/dist/opencode.schema.json",

  // Shared behavior only. Provider definitions, default models, and per-agent
  // model assignments belong in a machine-specific OPENCODE_CONFIG overlay.
  // This keeps the public agent contract reusable across machines and accounts.
  "snapshot": false,
  "share": "disabled",

  // Restrictive baseline. Individual agents reopen only the capabilities their
  // role requires. Repository publication remains an explicit user operation.
  "permission": {
    "edit": "deny",
    "task": {
      "*": "deny"
    },
    "webfetch": "deny",
    "websearch": "deny",
    "skill": {
      "*": "ask",
      "progressive-context-design": "allow",
      "cross-ai-review": "deny",
      "coding": "allow",
      "skill-creator": "deny",
      "diagnosing-bugs": "deny",
      "grilling": "deny"
    },
    "bash": {
      "*": "ask",
      "*git*push*": "deny",
      "*git*send-pack*": "deny",
      "*repo*upload*": "deny"
    }
  },

  "agent": {
    // The build agent owns planning and orchestration, so the built-in plan
    // agent is intentionally disabled.
    "plan": {
      "disable": true
    },

    "title": {
      "temperature": 0.1,
      "prompt": "{file:./prompts/title.md}"
    },

    "build": {
      "mode": "primary",
      "temperature": 0.1,
      "steps": 256,
      "prompt": "{file:./prompts/build.md}",
      "permission": {
        "edit": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "skill": {
          "cross-ai-review": "allow",
          "skill-creator": "ask",
          "diagnosing-bugs": "allow",
          "grilling": "allow"
        },
        "task": {
          "*": "ask",
          "generalL": "allow",
          "general": "allow",
          "generalH": "allow",
          "exploreL": "allow",
          "explore": "allow",
          "exploreH": "allow",
          "scoutL": "allow",
          "scout": "allow",
          "scoutH": "allow",
          "reviewL": "allow",
          "review": "allow",
          "reviewH": "allow",
          "criticL": "allow",
          "critic": "allow",
          "criticH": "allow"
        }
      }
    },

    // Provider-portable reasoning policy:
    // - reasoningEffort is consumed by OpenAI/Codex-style providers.
    // - effort is consumed by Anthropic-style adaptive reasoning.
    //
    // These pass-through options intentionally coexist so changing an agent's
    // backing model does not require redefining its reasoning tier. They are not
    // a promise that every provider accepts every option: validate compatibility
    // when adopting a new model/provider.
    //
    // Execution controls such as sandboxMode/approvalPolicy are provider-specific
    // and belong with the machine profile/model assignment. Model-specific
    // `thinking` configuration belongs with the provider/model definition too.

    "generalL": {
      "description": "L-tier implementation subagent; same role and capabilities as general/generalH, for implementation work whose reasoning demand is low.",
      "mode": "subagent",
      "reasoningEffort": "low",
      "effort": "low",
      "temperature": 0.1,
      "steps": 50,
      "permission": {
        "edit": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "skill": {
          "diagnosing-bugs": "allow"
        }
      },
      "prompt": "{file:./prompts/general.md}"
    },

    "general": {
      "description": "Default implementation subagent; same role and capabilities as generalL/generalH, for implementation work whose reasoning demand is moderate.",
      "mode": "subagent",
      "reasoningEffort": "medium",
      "effort": "medium",
      "temperature": 0.1,
      "steps": 120,
      "permission": {
        "edit": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "skill": {
          "diagnosing-bugs": "allow"
        }
      },
      "prompt": "{file:./prompts/general.md}"
    },

    "generalH": {
      "description": "H-tier implementation subagent; same role and capabilities as generalL/general, for implementation work whose reasoning demand is high.",
      "mode": "subagent",
      "reasoningEffort": "high",
      "effort": "high",
      "temperature": 0.1,
      "steps": 180,
      "permission": {
        "edit": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "skill": {
          "diagnosing-bugs": "allow"
        }
      },
      "prompt": "{file:./prompts/general.md}"
    },

    "exploreL": {
      "description": "L-tier local read-only investigation subagent; same role as explore/exploreH, for investigation whose reasoning demand is low.",
      "mode": "subagent",
      "reasoningEffort": "low",
      "effort": "low",
      "temperature": 0.1,
      "steps": 40,
      "prompt": "{file:./prompts/explore.md}"
    },

    "explore": {
      "description": "Default local read-only investigation subagent; same role as exploreL/exploreH, for investigation whose reasoning demand is moderate.",
      "mode": "subagent",
      "reasoningEffort": "medium",
      "effort": "medium",
      "temperature": 0.1,
      "steps": 80,
      "prompt": "{file:./prompts/explore.md}"
    },

    "exploreH": {
      "description": "H-tier local read-only investigation subagent; same role as exploreL/explore, for investigation whose reasoning demand is high.",
      "mode": "subagent",
      "reasoningEffort": "high",
      "effort": "high",
      "temperature": 0.1,
      "steps": 180,
      "prompt": "{file:./prompts/explore.md}"
    },

    "scoutL": {
      "description": "L-tier external/upstream research subagent; same role and capabilities as scout/scoutH, for research whose reasoning demand is low.",
      "mode": "subagent",
      "reasoningEffort": "low",
      "effort": "low",
      "temperature": 0.1,
      "steps": 45,
      "permission": {
        "webfetch": "allow",
        "websearch": "allow"
      },
      "prompt": "{file:./prompts/scout.md}"
    },

    "scout": {
      "description": "Default external/upstream research subagent; same role and capabilities as scoutL/scoutH, for research whose reasoning demand is moderate.",
      "mode": "subagent",
      "reasoningEffort": "medium",
      "effort": "medium",
      "temperature": 0.1,
      "steps": 90,
      "permission": {
        "webfetch": "allow",
        "websearch": "allow"
      },
      "prompt": "{file:./prompts/scout.md}"
    },

    "scoutH": {
      "description": "H-tier external/upstream research subagent; same role and capabilities as scoutL/scout, for research whose reasoning demand is high.",
      "mode": "subagent",
      "reasoningEffort": "high",
      "effort": "high",
      "temperature": 0.1,
      "steps": 150,
      "permission": {
        "webfetch": "allow",
        "websearch": "allow"
      },
      "prompt": "{file:./prompts/scout.md}"
    },

    "reviewL": {
      "description": "L-tier artifact-oriented independent review subagent; same role as review/reviewH, for review whose reasoning demand is low.",
      "mode": "subagent",
      "reasoningEffort": "low",
      "effort": "low",
      "temperature": 0.1,
      "steps": 35,
      "prompt": "{file:./prompts/review.md}"
    },

    "review": {
      "description": "Default artifact-oriented independent review subagent; same role as reviewL/reviewH, for review whose reasoning demand is moderate.",
      "mode": "subagent",
      "reasoningEffort": "medium",
      "effort": "medium",
      "temperature": 0.1,
      "steps": 60,
      "prompt": "{file:./prompts/review.md}"
    },

    "reviewH": {
      "description": "H-tier artifact-oriented independent review subagent; same role as reviewL/review, for review whose reasoning demand is high.",
      "mode": "subagent",
      "reasoningEffort": "high",
      "effort": "high",
      "temperature": 0.1,
      "steps": 100,
      "prompt": "{file:./prompts/review.md}"
    },

    "criticL": {
      "description": "L-tier judgment-oriented independent critic; same role as critic/criticH, for challenge whose reasoning demand is low.",
      "mode": "subagent",
      "reasoningEffort": "low",
      "effort": "low",
      "temperature": 0.1,
      "steps": 35,
      "prompt": "{file:./prompts/critic.md}"
    },

    "critic": {
      "description": "Default judgment-oriented independent critic; same role as criticL/criticH, for challenge whose reasoning demand is moderate.",
      "mode": "subagent",
      "reasoningEffort": "medium",
      "effort": "medium",
      "temperature": 0.1,
      "steps": 70,
      "prompt": "{file:./prompts/critic.md}"
    },

    "criticH": {
      "description": "H-tier judgment-oriented independent critic; same role as criticL/critic, for challenge whose reasoning demand is high.",
      "mode": "subagent",
      "reasoningEffort": "high",
      "effort": "high",
      "temperature": 0.1,
      "steps": 110,
      "prompt": "{file:./prompts/critic.md}"
    }
  }
}
